IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/resource/app.ico"

#include <windows.h>

#define VER_FILEVERSION             @COINFLIP_VERSION_COMMA@,0
#define VER_FILEVERSION_STR         "@COINFLIP_VERSION@\0"
#define VER_PRODUCTVERSION          @COINFLIP_VERSION_COMMA@,0
#define VER_PRODUCTVERSION_STR      "@COINFLIP_VERSION@\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Su2uka"
            VALUE "FileDescription",  "Mystic CoinFlip - flip coin puzzle game"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "CoinFlip"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Su2uka"
            VALUE "OriginalFilename", "CoinFlip.exe"
            VALUE "ProductName",      "Mystic CoinFlip"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
